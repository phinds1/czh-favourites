<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for GitHub Actions CI.
  Blocks the private czh nexus (unreachable from GitHub) so all resolution
  falls through to Maven Central only.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
                              https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <mirrors>
    <!-- Redirect every repository lookup to Maven Central; blocks private nexus. -->
    <mirror>
      <id>central-only</id>
      <name>Maven Central (CI mirror)</name>
      <url>https://repo1.maven.org/maven2</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

</settings>
